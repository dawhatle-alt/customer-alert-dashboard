# TypeSafe (Jev) API key. Copy this file to .env and fill it in; .env is git-ignored.
TYPESAFE_API_KEY=

# Salesforce CLI org alias used by the salesforce-bmc MCP server.
SF_ORG_ALIAS=bmc

# Minutes between checks.
CHECK_INTERVAL_MINUTES=30

# Only customer messages and engineer notes from the last N days are evaluated.
LOOKBACK_DAYS=14

# Dashboard port.
PORT=3000
